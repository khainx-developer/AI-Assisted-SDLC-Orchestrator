{
  "default_platform": "claude",
  "analysis_platform": "claude",
  "coding_platform": "copilot",
  "dispatch_timeout_minutes": 30,
  "branch_pattern": "story/{key}",
  "scope_check": "warn",
  "redact_secrets": true,
  "budget": { "task_tokens": 400000, "action": "warn" },
  "redact_extra": ["ACME-[0-9a-f]{16}"],
  "projects": {
    "D:/work/ProjectA": { "slug": "projecta", "model": "claude-sonnet-5-5", "branch_pattern": "feature/{key}", "coding_platform": "cursor", "test_command": "npm test", "tests_first": true, "scope_allow": ["package-lock.json"] }
  },
  "platforms": {
    "claude":  { "model": "claude-sonnet-5-5" },
    "copilot": { "extra_args": [] },
    "cursor":  { "command": "cursor-agent" },
    "mytool": {
      "command": "mytool",
      "args": ["run", "--mode", "{mode}", "--prompt-file", "{prompt_file}"],
      "prompt_via": "file"
    }
  }
}
