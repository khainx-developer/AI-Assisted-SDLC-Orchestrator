{
  "name": "ai-sdlc-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic SDLC control plane (workflow-state + dispatch MCP servers)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start:workflow-state": "node dist/mcp/workflow/server.js",
    "start:dispatch": "node dist/mcp/dispatch/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "sdlc-orchestrator": "dist/cli/index.js"
  }
}
